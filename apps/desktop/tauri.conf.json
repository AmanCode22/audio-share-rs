{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioShare Companion",
  "version": "1.0.0",
  "identifier": "io.audiosharers.companion",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audio Share Companion",
        "width": 1020,
        "height": 780,
        "minWidth": 800,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Share your computer's audio over the LAN",
    "longDescription": "Audio Share Rust companion: stream this computer's system audio to phones and laptops, or play a remote server's audio here. GTK/WebKitGTK based on Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
